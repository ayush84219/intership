# Live External Job & Internship Search APIs Configuration
JSEARCH_API_KEY=your_jsearch_rapidapi_key_here
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# SerpApi Google Jobs Search Configuration
SERPAPI_API_KEY=your_serpapi_key_here

# Adzuna & Jooble API configuration (Optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Gemini API configuration for AI Resume Parser
GEMINI_API_KEY=your_gemini_api_key_here

# NextAuth configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3005

# MySQL Database Configuration
DB_HOSTNAME=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_NAME=intership_portel

# Flask SQLAlchemy URI
# SQLite example: sqlite:///database/smart_internship.db
# MySQL example: mysql+mysqlconnector://root:password@localhost:3306/intership_portel
DATABASE_URL=mysql+mysqlconnector://root:your_password@localhost:3306/intership_portel
